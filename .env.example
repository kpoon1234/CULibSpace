# ==============================================================================
# CULibSpace - Root Environment Configuration (Docker Compose & Deployment)
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# ==============================================================================

# 🌐 Public Domain & Client URL
# For local testing: http://localhost:3000
# For Home Cloud Server or Custom Domain: https://culib.yourdomain.com
CLIENT_URL=http://localhost:3000

# ⚙️ Application Environment
NODE_ENV=production
PORT=8080

# 🐘 PostgreSQL Database (Docker internal connection)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=culibspace
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/culibspace?schema=public

# 🌱 Seeding Control
# By default, seed only runs if the database is brand new (0 admins / 0 zones).
# Set to 'true' if you explicitly want to wipe all tables and re-seed sample data.
FORCE_SEED=false

# 🔐 Security & Sessions
JWT_SECRET=culibspace_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
SESSION_SECRET=culibspace_session_secret_change_in_production

# 🔑 Google OAuth 2.0 Credentials (https://console.cloud.google.com/apis/credentials)
# Add your domain to Authorized JavaScript origins: https://culib.yourdomain.com
# Add your callback URL to Authorized redirect URIs: https://culib.yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALLBACK_URL is automatically derived from CLIENT_URL + /api/auth/google/callback,
# or you can override it explicitly:
# GOOGLE_CALLBACK_URL=https://culib.yourdomain.com/api/auth/google/callback

# 💳 Stripe Payment Gateway (Test Mode)
# Retrieve test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
# Optional: Override redirect URLs if needed (defaults to CLIENT_URL/tickets/success and CLIENT_URL/visitor/ticket)
# TICKET_CHECKOUT_SUCCESS_URL=https://culib.yourdomain.com/tickets/success
# TICKET_CHECKOUT_CANCEL_URL=https://culib.yourdomain.com/visitor/ticket
