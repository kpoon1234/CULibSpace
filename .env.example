# Docker Compose configuration (copy to .env at repository root when deploying)
POSTGRES_USER=postgres
# Required: generate a strong URL-safe value with `openssl rand -hex 32`.
POSTGRES_PASSWORD=
POSTGRES_DB=culibspace
POSTGRES_PORT=5432

# Host bind & port mapped to container port 3000
# Point Ubuntu host's Cloudflare Tunnel for culibspace.example.com to http://127.0.0.1:64000
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=64000

# Dedicated network used by Compose and backend TRUST_PROXY; change if it overlaps a host/VPN route.
DOCKER_SUBNET=172.30.85.0/24
