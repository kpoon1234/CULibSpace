# Optional Docker Compose overrides (copy to .env at repository root when deploying)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=culibspace
POSTGRES_PORT=5432

# Host bind & port mapped to container port 3000
# Point Ubuntu host's Cloudflare Tunnel for culibspace.andyntk.online to http://127.0.0.1:64000
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=64000
