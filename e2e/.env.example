# Copy to e2e/.env (git-ignored) only if your local setup differs from the defaults.
# Defaults: the dev servers on localhost and the accounts from apps/backend/prisma/seed.ts.
E2E_BASE_URL="http://localhost:3000"
E2E_API_URL="http://localhost:8080"
E2E_ADMIN_EMAIL="admin@chula.ac.th"
# The seed password is shorter than the login form's 6-character minimum, so the form
# rejects it. Set the admin password from your local database here.
E2E_ADMIN_PASSWORD="admin@example"
E2E_USER_EMAIL="alice@student.chula.ac.th"
E2E_USER_FIRSTNAME="Alice"
E2E_USER_LASTNAME="wonderland"
