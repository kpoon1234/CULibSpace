{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "npm run dev --workspace=apps/backend & npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:fresh": "docker compose up -d postgres && npm run db:fresh --workspace=apps/backend",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:seed": "docker compose run --rm migrate npx tsx prisma/seed.ts",
    "test:jest": "npm run test:jest --workspace=apps/backend"
  },
  "lint-staged": {
    "apps/**/*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "name": "culibspace",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.2",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  },
  "dependencies": {
    "stripe": "^23.0.1"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "body-parser": "2.4.0",
    "qs": "6.16.2",
    "deepmerge-ts": "^8.0.2",
    "uri-js": "npm:fast-uri@^4.2.3",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    }
  },
  "scarfSettings": {
    "enabled": false
  }
}
