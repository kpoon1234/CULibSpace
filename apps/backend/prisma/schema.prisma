// Prisma Schema for CU LibSpace
// Database: PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserType {
  UNIVERSITY
  THAI
  FOREIGN

  @@map("user_type_enum")
}

enum TableStatus {
  AVAILABLE  @map("Available")
  RESERVED   @map("Reserved")
  OCCUPIED   @map("Occupied")
  CLOSED     @map("Closed")

  @@map("table_status_enum")
}

enum BookingStatus {
  PENDING    @map("Pending")
  ACTIVE     @map("Active")
  COMPLETED  @map("Completed")
  CANCELLED  @map("Cancelled")
  NO_SHOW    @map("No-show")

  @@map("booking_status_enum")
}

enum TicketStatus {
  PAID       @map("Paid")
  UNPAID     @map("Unpaid")

  @@map("ticket_status_enum")
}

// [US6-1] สถานะรายการชำระเงินผ่าน Payment Gateway
enum PaymentStatus {
  PENDING     @map("Pending")
  // ผลของ gateway ไม่ชัดเจน (timeout / ติดต่อไม่ได้) -> อาจสร้าง checkout แล้วหรือยังไม่สร้าง
  // ต้อง reconcile รายการเดิมก่อน จึงจะอนุญาตให้เริ่มรายการใหม่ได้
  UNCONFIRMED @map("Unconfirmed")
  PAID        @map("Paid")
  FAILED      @map("Failed")
  EXPIRED     @map("Expired")
  REFUNDED    @map("Refunded")

  @@map("payment_status_enum")
}

enum ZoneType {
  SILENT     @map("Silent")
  GROUP      @map("Group")
  COMMON     @map("Common")

  @@map("zone_type_enum")
}

enum IssueStatus {
  PENDING     @map("Pending")
  IN_PROGRESS @map("In Progress")
  COMPLETED   @map("Completed")

  @@map("issue_status_enum")
}

// ==========================================
// MODELS: USER & POLYMORPHIC INHERITANCE
// ==========================================

model User {
  uid               Int             @id @default(autoincrement()) @map("uid")
  phone             String?         @unique @db.VarChar(10) @map("phone")
  isProfileComplete Boolean         @default(false) @map("is_profile_complete")
  behaviourScore    Int             @default(100) @map("behaviour_score")
  email             String          @unique @db.VarChar(100) @map("email")
  firstname         String          @db.VarChar(50) @map("firstname")
  lastname          String          @db.VarChar(50) @map("lastname")
  imageUrl          String?         @db.VarChar(255) @map("image_url") @default("https://www.gravatar.com/avatar/00000000000000000000000000000000?d=mp&f=y")
  userType          UserType        @map("user_type")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  // Polymorphic Subtype Relations (Class Table Inheritance)
  universityUser UniversityUser?
  outsideUser    OutsideUser?

  // Domain Relations
  bookings       Booking[]
  issueReports   IssueReport[]
  manageScores   ManageScore[]

  // Indexes for User Lookup & Admin Filters
  @@index([firstname, lastname], name: "idx_user_name_search")
  @@index([userType], name: "idx_user_type")
  @@map("user")
}

model UniversityUser {
  uid       Int      @id @map("uid")
  studentId String   @unique @db.VarChar(10) @map("studentid")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [uid], references: [uid], onDelete: Cascade)

  @@map("university_user")
}

model OutsideUser {
  uid         Int          @id @map("uid")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user        User         @relation(fields: [uid], references: [uid], onDelete: Cascade)
  thaiUser    ThaiUser?
  foreignUser ForeignUser?
  tickets     Ticket[]

  @@map("outside_user")
}

model ThaiUser {
  uid         Int         @id @map("uid")
  citizenId   String      @unique @db.VarChar(13) @map("citizenid")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  outsideUser OutsideUser @relation(fields: [uid], references: [uid], onDelete: Cascade)

  @@map("thai_user")
}

model ForeignUser {
  uid         Int         @id @map("uid")
  passportId  String      @unique @db.VarChar(9) @map("passportid")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  outsideUser OutsideUser @relation(fields: [uid], references: [uid], onDelete: Cascade)

  @@map("foreign_user")
}

model Admin {
  adminId      Int           @id @default(autoincrement()) @map("adminid")
  email        String        @unique @db.VarChar(100) @map("email")
  password     String        @db.VarChar(255) @map("password") // bcrypt hash for Admin login
  firstname    String        @db.VarChar(50) @map("firstname")
  lastname     String        @db.VarChar(50) @map("lastname")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  managedIssues ManageIssue[]
  managedScores ManageScore[]

  @@map("admin")
}

// ==========================================
// MODELS: SPATIAL ZONE & TABLE
// ==========================================

model Zone {
  zoneId    Int      @id @default(autoincrement()) @map("zoneid")
  zoneType  ZoneType @map("zone_type")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tables    Table[]

  @@map("zone")
}

model Table {
  tableId      Int         @id @default(autoincrement()) @map("tableid")
  zoneId       Int         @map("zoneid")
  status       TableStatus @default(AVAILABLE) @map("status")
  numberOfSeat Int         @map("number_of_seat")
  plugCap      Int?        @map("plug_cap")
  hasTvScreen  Boolean     @default(false) @map("has_tv_screen")

  // Temporary Hold Lock Mechanism (Double Booking Prevention / Concurrency)
  lockToken    String?     @map("lock_token")
  lockedUntil  DateTime?   @map("locked_until") @db.Timestamptz
  lockedByUid  Int?        @map("locked_by_uid")

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // Relations
  zone         Zone          @relation(fields: [zoneId], references: [zoneId])
  bookings     Booking[]
  issueReports IssueReport[]

  // Indexes for Real-time Availability & SWR Polling Filters
  @@index([zoneId, status], name: "idx_table_zone_status")
  @@index([status, plugCap, hasTvScreen], name: "idx_table_amenity_filter")
  @@index([lockedUntil], name: "idx_table_locked_until")
  @@map("table")
}

// ==========================================
// MODELS: BOOKING & CONCURRENCY
// ==========================================

model Booking {
  bookingId     Int           @id @default(autoincrement()) @map("bookingid")
  uid           Int           @map("uid")
  tableId       Int           @map("tableid")
  startDateTime DateTime      @map("startdatetime")
  endDateTime   DateTime      @map("enddatetime")
  arriveTime    DateTime?     @map("arrive_time")
  status        BookingStatus @default(PENDING) @map("status")
  timestamp     DateTime      @default(now()) @map("timestamp")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  user          User          @relation(fields: [uid], references: [uid])
  table         Table         @relation(fields: [tableId], references: [tableId])

  // 1. ตรวจสอบโต๊ะว่าง/ช่วงเวลาจองทับซ้อน (Table Availability & Overlap Check)
  @@index([tableId, status, startDateTime, endDateTime], name: "idx_booking_table_overlap")

  // 2. นโยบาย 1 บัญชี 1 ที่นั่ง & ตรวจสอบการจองของผู้ใช้ (User Active & Overlap Check)
  @@index([uid, status, startDateTime, endDateTime], name: "idx_booking_user_overlap")

  // 3. ดึงประวัติการจองของผู้ใช้เรียงตามเวลาล่าสุด (User Booking History Timeline)
  @@index([uid, timestamp(sort: Desc)], name: "idx_booking_user_history")

  // 4. ค้นหาผู้ไม่มาแสดงตัวสำหรับ Cron/Worker Auto No-show Release
  @@index([status, startDateTime], name: "idx_booking_noshow_worker")

  @@map("booking")
}

// ==========================================
// MODELS: VISITOR TICKETING
// ==========================================

model Ticket {
  ticketId      Int          @id @default(autoincrement()) @map("ticketid")
  uid           Int          @map("uid")
  paymentDetail String?      @db.VarChar(255) @map("payment_detail")
  status        TicketStatus @default(UNPAID) @map("status")
  startDateTime DateTime     @map("startdatetime")
  endDateTime   DateTime     @map("enddatetime")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  outsideUser   OutsideUser  @relation(fields: [uid], references: [uid])
  payments      Payment[]

  // ตรวจสอบสิทธิ์ตั๋ว Active ที่ครอบคลุมช่วงเวลาจองของบุคคลภายนอก (fn_check_ticket_for_outsider)
  @@index([uid, status, startDateTime, endDateTime], name: "idx_ticket_active_coverage")
  @@map("ticket")
}

// [US6-1] ตาราง Payment ผูกกับ Ticket เพื่อเก็บยอดเงิน (หน่วยสตางค์), สกุลเงิน,
// สถานะการชำระเงิน, gateway reference และ idempotency key
// ตกลง schema ชุดเดียวกับทีม US6-2 / US6-3 (migration กลาง)
model Payment {
  paymentId      Int           @id @default(autoincrement()) @map("paymentid")
  ticketId       Int           @map("ticketid")
  uid            Int           @map("uid")
  // ยอดเงินเก็บเป็นหน่วยสตางค์ (1 THB = 100 satang) เพื่อเลี่ยง floating point
  amountSatang   Int           @map("amount_satang")
  currency       String        @default("THB") @db.VarChar(3) @map("currency")
  status         PaymentStatus @default(PENDING) @map("status")
  // ระบุผู้ให้บริการเก็บเงิน เช่น 'stripe' (รองรับการเปลี่ยน gateway ในอนาคต)
  gateway        String        @db.VarChar(32) @map("gateway")
  // อ้างอิงฝั่ง gateway (เช่น Stripe Checkout Session ID) ใช้จับคู่ webhook
  gatewayRef     String?       @db.VarChar(255) @map("gateway_ref")
  // key ที่ client ส่งมา (สูงสุด 64 ตัวอักษร) ใช้ควบคุมไม่ให้เกิดรายการซ้ำต่อ 1 ผู้ใช้
  clientKey      String        @db.VarChar(64) @map("client_key")
  // key เต็มที่ส่งต่อให้ gateway (ผูก uid + client_key) ใช้ซ้ำได้กับ gateway เพื่อกู้รายการเดิม
  idempotencyKey String        @db.VarChar(128) @map("idempotency_key")
  checkoutUrl    String?       @db.Text @map("checkout_url")
  // payload สำหรับสร้าง checkout ที่ "เตรียมไว้แล้ว" เก็บเป็น JSON
  // ต้องใช้ payload ชุดเดิมทุกครั้งที่ retry เพราะ gateway จะปฏิเสธการใช้
  // idempotency key เดิมถ้าพารามิเตอร์ต่างกัน (เช่น expires_at ที่คำนวณใหม่)
  checkoutPayload String?      @db.Text @map("checkout_payload")
  // อายุใช้งานตั๋วที่ snapshot ไว้ตอนซื้อ (ชั่วโมง) ไม่อ่าน config ซ้ำตอนยืนยันการจ่ายเงิน
  // เพราะ config อาจถูกแก้ระหว่างที่ผู้ใช้กำลังกรอกข้อมูลในหน้า checkout
  ticketValidityHours Int      @map("ticket_validity_hours")
  // เวลาหมดอายุของคำสั่งซื้อ (payment attempt) ไม่ใช่อายุใช้งานตั๋ว
  expiresAt      DateTime      @map("expires_at")
  // ช่อง "รายการที่เปิดอยู่" ของผู้ใช้ (UNIQUE)
  // ตั้งค่าเป็น uid ตอนสร้างรายการ และล้างเป็น NULL เมื่อรายการออกจากสถานะเปิด
  // -> บังคับว่าผู้ใช้มีรายการที่ยังเปิดอยู่ได้แค่รายการเดียว
  //    (กันสร้าง checkout ซ้ำ และบังคับให้กู้รายการเดิมก่อนซื้อใหม่)
  // หมายเหตุ: US6-3 ต้องล้าง openUid เมื่อ payment เปลี่ยนเป็น Paid/Expired/Failed
  openUid        Int?          @unique(map: "payment_open_uid_key") @map("open_uid")
  // เวลา backend ยืนยันและเปิดใช้ตั๋วครั้งแรก ไม่ใช่เวลาสร้าง Stripe Charge
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Relations
  ticket         Ticket        @relation(fields: [ticketId], references: [ticketId], onDelete: Cascade)
  webhookEvents  PaymentWebhookEvent[]

  // หนึ่งผู้ใช้ + หนึ่ง client key = หนึ่งรายการซื้อ (ตัวตั้งกันรายการซ้ำอยู่ที่ระดับ DB)
  // map: ต้องตรงกับชื่อ index ที่ migration สร้างจริง ไม่งั้น Prisma จะคิดว่ามี diff
  @@unique([uid, clientKey], name: "uq_payment_user_client_key", map: "uq_payment_user_client_key")
  @@index([uid, status], name: "idx_payment_user_status")
  @@index([status, expiresAt], name: "idx_payment_expiry")
  @@index([gatewayRef], name: "idx_payment_gateway_ref")
  @@map("payment")
}

// Successful confirmation receipts only. Unhandled failed/expired events belong
// to the other US6-3 task and must NOT be marked processed here.
model PaymentWebhookEvent {
  gateway     String   @db.VarChar(32) @map("gateway")
  eventId     String   @db.VarChar(255) @map("event_id")
  paymentId   Int      @map("paymentid")
  gatewayRef  String   @db.VarChar(255) @map("gateway_ref")
  processedAt DateTime @default(now()) @map("processed_at")
  payment     Payment  @relation(fields: [paymentId], references: [paymentId], onDelete: Cascade)

  @@id([gateway, eventId])
  @@index([paymentId], map: "idx_payment_webhook_payment")
  @@map("payment_webhook_event")
}

// ==========================================
// MODELS: FACILITY & AUDIT LOGS
// ==========================================

model IssueReport {
  issueId          Int           @id @default(autoincrement()) @map("issueid")
  uid              Int           @map("uid")
  time             DateTime      @default(now()) @map("time")
  tableId          Int           @map("tableid")
  issueInformation String        @db.Text @map("issue_information")
  status           IssueStatus   @default(PENDING) @map("status")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  user             User          @relation(fields: [uid], references: [uid])
  table            Table         @relation(fields: [tableId], references: [tableId])
  manageIssues     ManageIssue[]

  @@index([tableId], name: "idx_issue_table")
  @@index([uid], name: "idx_issue_user")
  @@index([status, time(sort: Desc)], map: "idx_issue_report_status_time")
  @@map("issue_report")
}

model ManageIssue {
  issueId   Int         @map("issueid")
  adminId   Int         @map("adminid")
  timestamp DateTime    @default(now()) @map("timestamp")
  info      String      @db.Text @map("info")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  // Relations
  issueReport IssueReport @relation(fields: [issueId], references: [issueId])
  admin       Admin       @relation(fields: [adminId], references: [adminId])

  @@id([issueId, adminId, timestamp])
  @@map("manage_issue")
}

model ManageScore {
  manageScoreId Int      @id @default(autoincrement()) @map("manage_score_id")
  uid           Int      @map("uid")
  adminId       Int      @map("adminid")
  timestamp     DateTime @default(now()) @map("timestamp")
  scoreChange   Int      @map("score_change")
  reason        String   @default("System Adjustment") @map("reason") @db.Text // <-- เพิ่มฟิลด์นี้
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user        User     @relation(fields: [uid], references: [uid])
  admin       Admin    @relation(fields: [adminId], references: [adminId])

  @@index([uid, timestamp])
  @@map("manage_score")
}

// ==========================================
// MODELS: OPERATING SCHEDULE (ตารางเวลาเปิด-ปิดตามช่วงวัน)
// ==========================================

model OperatingSchedule {
  scheduleId  Int      @id @default(autoincrement()) @map("schedule_id")
  name        String   @map("name") @db.VarChar(100) // เช่น "ช่วงสอบกลางภาค 1/2569", "เวลาทำการปกติ"
  startDate   DateTime @map("start_date") @db.Date    // วันเริ่มต้นที่มีผล
  endDate     DateTime @map("end_date") @db.Date      // วันสิ้นสุดที่มีผล
  openTime    String   @default("08:00") @map("open_time") @db.VarChar(5) // "08:00"
  closeTime   String   @default("21:00") @map("close_time") @db.VarChar(5)// "21:00"
  is24Hours   Boolean  @default(false) @map("is_24h") // true = เปิด 24 ชม.
  isClosed    Boolean  @default(false) @map("is_closed") // true = ปิดปรับปรุง/วันหยุด
  priority    Int      @default(1) @map("priority")   // 1=ปกติ, 2=ช่วงสอบ, 3=วันหยุดพิเศษ/ปิดปรับปรุง
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([startDate, endDate, priority], name: "idx_schedule_lookup")
  @@map("operating_schedule")
}

// ==========================================
// MODELS: SYSTEM CONFIGURATION
// ==========================================

model SystemConfig {
  configId                  Int      @id @default(autoincrement()) @map("configid")
  maxBookingDurationMinutes Int      @default(120) @map("max_booking_duration_minutes")
  lateThresholdMinutes      Int      @default(15) @map("late_threshold_minutes")
  earlyCheckInMinutes       Int      @default(15) @map("early_checkin_minutes")
  minScoreToBook            Int      @default(50) @map("min_score_to_book")
  maxAdvanceBookingDays     Int      @default(7) @map("max_advance_booking_days")
  // [US6-1] ราคาตั๋วผู้เข้าชมภายนอก (หน่วยสตางค์) และอายุใช้งานตั๋ว (ชั่วโมง)
  // กำหนดโดย Backend เท่านั้น client ส่งมาไม่ได้
  ticketPriceSatang         Int      @default(5000) @map("ticket_price_satang")
  ticketValidityHours       Int      @default(2) @map("ticket_validity_hours")
  // อายุของ Checkout Session (นาที) ต้อง >= 30 ตามข้อกำหนดของ Stripe
  paymentCheckoutExpiryMinutes Int   @default(30) @map("payment_checkout_expiry_minutes")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}
