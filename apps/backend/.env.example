# Local host Prisma CLI connection (Docker Compose overrides DATABASE_URL automatically inside containers)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/culibspace?schema=public"
PORT=8080

# Public frontend URL (used for CORS origin and OAuth post-login redirects)
# Local dev: http://localhost:3000
# Cloudflare Tunnel (Ubuntu): https://culibspace.example.com
CLIENT_URL="http://localhost:3000"

# Swagger UI at /api-docs. Default: on, except when NODE_ENV=production.
# Set "true" or "false" to override (e.g. ENABLE_API_DOCS=true on a staging server).
ENABLE_API_DOCS=""
# Public base URL(s) of this API, shown in Swagger UI (/api-docs) "Servers" dropdown.
# Comma-separated. Leave empty to use the same origin as the docs page (works on any deployment).
# Example: API_PUBLIC_URL="https://api.culibspace.example.com,http://localhost:8080"
API_PUBLIC_URL=""

# Set to "production" when deploying behind HTTPS (Cloudflare Tunnel)
NODE_ENV=development

# Comma-separated trusted proxy IPs/CIDRs. Empty = ignore forwarded headers.
# Local hybrid setup: TRUST_PROXY="loopback"
# Docker Compose sets TRUST_PROXY to its dedicated DOCKER_SUBNET (default: 172.30.85.0/24).
TRUST_PROXY=""

# Replace with long random secrets before deploying (e.g. `openssl rand -hex 32`)
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="your-session-secret-key"

# Google OAuth 2.0 Credentials
# In Google Cloud Console -> Authorized redirect URIs, add the exact GOOGLE_CALLBACK_URL below.
# Cloudflare Tunnel (Ubuntu): https://culibspace.example.com/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:8080/api/auth/google/callback"

# [US6-1] Payment Gateway (Stripe - test mode only; live keys are rejected)
# STRIPE_SECRET_KEY from https://dashboard.stripe.com/test/apikeys (must start with sk_test_ or rk_test_)
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxx"
# STRIPE_WEBHOOK_SECRET from Stripe Dashboard webhook endpoint:
#   https://culibspace.example.com/api/tickets/payment/webhook
# Or local CLI: stripe listen --forward-to localhost:8080/api/tickets/payment/webhook
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"
PAYMENT_GATEWAY="stripe"
PAYMENT_GATEWAY_TIMEOUT_MS="10000"

# Stripe Hosted Checkout return URLs
# Cloudflare Tunnel (Ubuntu):
#   TICKET_CHECKOUT_SUCCESS_URL="https://culibspace.example.com/tickets/success"
#   TICKET_CHECKOUT_CANCEL_URL="https://culibspace.example.com/tickets/cancel"
TICKET_CHECKOUT_SUCCESS_URL="http://localhost:3000/tickets/success"
TICKET_CHECKOUT_CANCEL_URL="http://localhost:3000/tickets/cancel"
