DATABASE_URL="postgresql://postgres:postgres@localhost:5432/culibspace?schema=public"
PORT=8080
CLIENT_URL="http://localhost:3000"
NODE_ENV=development
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="your-session-secret-key"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:8080/api/auth/google/callback"

# [US6-1] Payment Gateway (Stripe - test mode)
# STRIPE_SECRET_KEY ได้จาก https://dashboard.stripe.com/test/apikeys (เริ่มด้วย sk_test_)
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxx"
# STRIPE_WEBHOOK_SECRET ได้จาก stripe listen --forward-to localhost:8080/api/tickets/payment/webhook
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"
# ชื่อ gateway ที่ใช้ (default: stripe)
PAYMENT_GATEWAY="stripe"
# timeout ของการเรียก gateway (มิลลิวินาที)
PAYMENT_GATEWAY_TIMEOUT_MS="10000"
# URL หลังชำระเงินสำเร็จ / ยกเลิก (ส่งต่อให้ Stripe redirect กลับมา)
TICKET_CHECKOUT_SUCCESS_URL="http://localhost:3000/tickets/success"
TICKET_CHECKOUT_CANCEL_URL="http://localhost:3000/tickets/cancel"
